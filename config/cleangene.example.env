# Increase or decrease array concurrency to match site policy.
# Example: SLURM_MAX_PARALLEL=100
# Split large arrays so sites that count array elements against QOS limits are safe.
# Example: SLURM_ARRAY_CHUNK_SIZE=500
# Example: SLURM_MAX_OUTSTANDING_CHUNKS=8
# Example: SLURM_PREPROCESS_MAX_INFLIGHT=400
# Example: SLURM_VALIDATION_MAX_INFLIGHT=400
# Example: SLURM_GROUP_MAX_INFLIGHT=8
# Example: SLURM_USER_JOB_LIMIT=2000
# Example: SLURM_JOB_HEADROOM=10
# Optional CPU-aware submit cap; 0 preserves existing job-count behavior.
# Example: SLURM_USER_CPU_LIMIT=0
# Example: SLURM_CPU_HEADROOM=0
# Example: SLURM_POLL_SECONDS=20

# Optional node-local preprocessing/Kraken acceleration:
# SKIP_TRIM=false
# SKIP_SHOVILL=false
# ASSEMBLER=shovill
# SPADES_MEMORY_GB=28
# COMPRESS_ASSEMBLY_OUTPUTS=off
# COMPRESS_ANNOTATION_OUTPUTS=off
# PREPROCESS_USE_NODE_LOCAL_SCRATCH=true
# PREPROCESS_SCRATCH_DIR=
# CLEANUP_TRIMMED_FASTQ=false
# RESUME_REPROCESS_INCONSISTENT_PREPROCESS=false
CHECKM2_MODE=required
CHECKM2_DB=
CHECKM2_DATABASE_ROOT=
CHECKM2_AUTO_DOWNLOAD=true
QC_MAX_CONTIGS_PASS=300
QC_MAX_CONTIGS_FAIL=1000
QC_MIN_N50_PASS=25000
QC_MIN_N50_FAIL=5000
QC_MIN_COVERAGE_PASS=20
QC_MIN_COVERAGE_FAIL=10
QC_MIN_READ_LENGTH_PASS=120
QC_MIN_READ_LENGTH_FAIL=
QC_MIN_MEAN_BASE_QUALITY_PASS=30
QC_MIN_MEAN_BASE_QUALITY_FAIL=
QC_MIN_COMPLETENESS_PASS=90
QC_MIN_COMPLETENESS_FAIL=80
QC_MAX_CHECKM2_CONTAMINATION_PASS=5
QC_MAX_CHECKM2_CONTAMINATION_FAIL=10
QC_MAX_KRAKEN_CONTAMINATION_FAIL=5
QC_PROFILE_FILE=
# KRAKEN2_DB_ACCESS=auto
# KRAKEN2_DB=
# KRAKEN2_DATABASE_ROOT=
# KRAKEN2_AUTO_DOWNLOAD=true
# KRAKEN2_DATABASE_SIZE=standard-8
# KRAKEN2_NODE_CACHE_DIR=
# KRAKEN2_NODE_CACHE_MIN_FREE_GB=2
# KRAKEN2_KEEP_CLASSIFICATIONS=false

# Optional downstream utility resources:
# UTILS_CPUS=8
# UTILS_MEM=32G
# UTILS_TIME=12:00:00
# UTILS_VARIANT_CPUS=16
# UTILS_VARIANT_MEM=64G
# UTILS_VARIANT_TIME=24:00:00
# UTILS_DIAGNOSTIC_CPUS=16
# UTILS_DIAGNOSTIC_MEM=128G
# UTILS_DIAGNOSTIC_TIME=48:00:00
