# ARC-oriented CleanGene configuration.
# This deliberately leaves SLURM_PARTITION empty so ARC's scheduler can choose
# any eligible partition from the requested CPU, memory, and time.

SLURM_ACCOUNT=""
SLURM_PARTITION=""
SLURM_MAX_PARALLEL="400"
SLURM_ARRAY_CHUNK_SIZE="500"
SLURM_MAX_OUTSTANDING_CHUNKS="8"
SLURM_PREPROCESS_MAX_INFLIGHT="400"
SLURM_VALIDATION_MAX_INFLIGHT="400"
SLURM_GROUP_MAX_INFLIGHT="8"
SLURM_USER_JOB_LIMIT="2000"
SLURM_JOB_HEADROOM="10"
SLURM_USER_CPU_LIMIT="0"
SLURM_CPU_HEADROOM="0"
SLURM_POLL_SECONDS="20"
SLURM_CONTROLLER_CPUS="1"
SLURM_CONTROLLER_MEM="4G"
SLURM_CONTROLLER_TIME="7-00:00:00"

# Isolate preprocessing: Shovill/Prokka/Kraken2/read conversion.
CPUS="8"
SLURM_CPUS="8"
SLURM_MEM="32G"
SLURM_TIME="16:00:00"

# Group pangenome tiers. Groups are submitted smallest first:
# small <= 499 isolates, medium 500-2000, large > 2000.
PANAROO_SMALL_MAX_ISOLATES="499"
PANAROO_MEDIUM_MAX_ISOLATES="2000"
PANAROO_SMALL_CPUS="16"
PANAROO_SMALL_MEM="128G"
PANAROO_SMALL_TIME="24:00:00"
PANAROO_MEDIUM_CPUS="32"
PANAROO_MEDIUM_MEM="512G"
PANAROO_MEDIUM_TIME="72:00:00"
PANAROO_LARGE_CPUS="64"
PANAROO_LARGE_MEM="1000G"
PANAROO_LARGE_TIME="168:00:00"

# Read validation is intentionally broad and highly parallel.
VALIDATION_CPUS="4"
VALIDATION_MEM="16G"
VALIDATION_TIME="12:00:00"

SUMMARY_CPUS="4"
SUMMARY_MEM="16G"
SUMMARY_TIME="04:00:00"

PLOT_CPUS="2"
PLOT_MEM="8G"
PLOT_TIME="02:00:00"
PLOT_MAX_CLUSTER_ISOLATES="2000"

# Downstream utilities. Variant analysis remaps retained reads and gets a
# larger allocation than matrix-only cohort/operon/iTOL analyses.
UTILS_CPUS="8"
UTILS_MEM="32G"
UTILS_TIME="12:00:00"
UTILS_VARIANT_CPUS="16"
UTILS_VARIANT_MEM="64G"
UTILS_VARIANT_TIME="24:00:00"
UTILS_DIAGNOSTIC_CPUS="16"
UTILS_DIAGNOSTIC_MEM="128G"
UTILS_DIAGNOSTIC_TIME="48:00:00"

GROUP_ORCHESTRATOR_CPUS="2"
GROUP_ORCHESTRATOR_MEM="8G"
GROUP_ORCHESTRATOR_TIME="04:00:00"

# Taxonomy/grouping:
# auto uses contamination mode when organism is supplied and identify mode when
# organism/group are missing.
TAXONOMY_MODE="auto"
# KRAKEN2_DB:
#   Optional exact database path. Normally leave blank.
#
# KRAKEN2_DATABASE_ROOT:
#   Optional parent directory for shared automatically managed databases.
#   Blank = <CleanGene>/databases.
#
# KRAKEN2_DATABASE_SIZE:
#   standard-8, standard-16, or standard.
#
# When KRAKEN2_DB is blank, CleanGene reuses the selected database from the
# shared database root and downloads it there only when absent.
KRAKEN2_DB=""
KRAKEN2_DATABASE_ROOT=""
KRAKEN2_AUTO_DOWNLOAD="true"
KRAKEN2_DATABASE_SIZE="standard-8"
KRAKEN2_CLEAN_BUILD_FILES="true"
KRAKEN2_DB_CPUS="8"
KRAKEN2_DB_MEM="64G"
KRAKEN2_DB_TIME="08:00:00"
KRAKEN2_KEEP_CLASSIFICATIONS="false"
KRAKEN2_BUNDLE_SIZE="8"
KRAKEN2_DB_ACCESS="auto"
KRAKEN2_NODE_CACHE_DIR=""
KRAKEN2_NODE_CACHE_MIN_FREE_GB="2"

# Read preprocessing:
READ_TRIMMING_MODE="auto"
# Set SKIP_TRIM=true, or pass --skip_trim, to skip fastp adapter trimming and
# store run-local symlinks to the original manifest FASTQs in isolate QC.
SKIP_TRIM="false"
# Set SKIP_SHOVILL=true, or pass --skip_shovill, for FASTQ/Kraken QC only.
# This implies SKIP_TRIM, records QC and symlinked reads, but does not
# assemble/annotate genomes.
SKIP_SHOVILL="false"
# Assembly engine: shovill (default), spades (direct, untrimmed FASTQs with
# spades.py --only-assembler), or off.
# Legacy SKIP_SHOVILL=true remains equivalent to ASSEMBLER=off.
ASSEMBLER="shovill"
# Passed to direct SPAdes as -m, in GiB.
SPADES_MEMORY_GB="28"
SHOVILL_RAM_GB=""
SHOVILL_DEPTH="150"
SHOVILL_GENOME_SIZE=""
GENOME_SIZE_MAP=""
# Assembly storage mode: off, intermediates, or all. "intermediates" compresses
# Shovill/SPAdes leftovers such as spades.fasta and spades.gfa while leaving the
# final contigs.fa plain. "all" also compresses contigs.fa and records
# contigs.fa.gz in QC for downstream tools that can read compressed FASTA.
COMPRESS_ASSEMBLY_OUTPUTS="off"
# Annotation storage mode: off or nonessential. Keep .gff plain because Panaroo,
# resume checks, and CleanGene utilities use it; compress other Prokka outputs.
COMPRESS_ANNOTATION_OUTPUTS="off"
ANNOTATION_MODE="fast_cluster"
PRODIGAL_TRAINING_MODE="auto"
PRODIGAL_TRAINING_MAP=""
PREPROCESS_USE_NODE_LOCAL_SCRATCH="true"
PREPROCESS_SCRATCH_DIR=""
# Set true to replace retained trimmed FASTQs with symlinks to the original
# manifest FASTQs after validation, reduction, plotting, and summary finish.
CLEANUP_TRIMMED_FASTQ="false"
# Fail closed when resume sees ambiguous or malformed terminal preprocess output.
RESUME_REPROCESS_INCONSISTENT_PREPROCESS="false"

# Isolate-level assembly/read QC. CheckM2 is required unless explicitly off.
CHECKM2_MODE="required"
CHECKM2_DB=""
CHECKM2_BATCH_SIZE="100"
CHECKM2_CPUS="16"
CHECKM2_MEM="128G"
CHECKM2_TIME="24:00:00"
CHECKM2_MAX_INFLIGHT="8"
QC_MAX_CONTIGS_PASS="300"
QC_MAX_CONTIGS_FAIL="1000"
QC_MIN_N50_PASS="25000"
QC_MIN_N50_FAIL="5000"
QC_MIN_COVERAGE_PASS="20"
QC_MIN_COVERAGE_FAIL="10"
QC_MIN_READ_LENGTH_PASS="120"
QC_MIN_READ_LENGTH_FAIL=""
QC_MIN_MEAN_BASE_QUALITY_PASS="30"
QC_MIN_MEAN_BASE_QUALITY_FAIL=""
QC_MIN_COMPLETENESS_PASS="90"
QC_MIN_COMPLETENESS_FAIL="80"
QC_MAX_CHECKM2_CONTAMINATION_PASS="5"
QC_MAX_CHECKM2_CONTAMINATION_FAIL="10"
QC_MAX_KRAKEN_CONTAMINATION_FAIL="5"
QC_PROFILE_FILE=""
